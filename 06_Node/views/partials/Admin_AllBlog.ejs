<div class="container d-flex flex-wrap mt-4">
  <% allBlog.forEach(element=> { %>

    <div class="card m-3" style="width: 18rem;">
      <img
        style="width: 80%; height: 150px; background-color: white; object-fit:contain; margin: auto; margin-top: 10px; "
        src=<%=element.coverImageURL %> class="card-img-top" />
      <div class="card-body">
        <h5 class="card-title">
          <%= element.title %>
        </h5>
        <div class="ellipsis-text">
          <%= element.body %>
        </div>
        <a href="/user/admin/blog/<%= element._id %>" class="btn btn-primary">Read Blog</a>
      </div>
    </div>
    <% }) %>
</div>