<div class="container d-flex flex-wrap mt-4" style="justify-content: center; width: 1200px;">

  <% allUser.forEach(user=> { %>
    <div class="card m-3" style="width: 100%;">
      <div class="card-header">
        <h6>User ID : <%= user._id %>
        </h6>
      </div>
      <div class="card-body">
        <h5>
          <%= user.fullname %>
        </h5>
        <h5 class="card-title">
          <%= user.email %>
        </h5>
        <form action="/user/admin/remove/<%= user._id %>?_method=DELETE" method="post">
          <button type="submit" class="btn btn-primary">Remove</button>
        </form>
      </div>
    </div>
    <% }) %>
</div>