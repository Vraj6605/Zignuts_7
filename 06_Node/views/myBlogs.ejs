<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("./partials/head") %>
    <title>
      <%= user.name %>'s Blogs
    </title>
    <style>
      .ellipsis-text {
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        height: 50px;
      }
    </style>
</head>

<body>
  <%- include("./partials/nav") %>
    <div class="container d-flex flex-wrap mt-4">
      <% allBlog.forEach(element=> { %>
        <div class="card m-3" style="width: 18rem;">
          <img
            style="width: 80%; height: 150px; background-color: white; object-fit:contain; margin: auto; margin-top: 10px; "
            src=<%=element.coverImageURL %> class="card-img-top" />
          <div class="card-body">
            <h5 class="card-title">
              <%= element.title %>
            </h5>
            <div class="ellipsis-text">
              <%= element.body %>
            </div>

            <div class="d-flex flex-row gap-2">
              <a href="/blog/<%= element._id %>" class="btn btn-primary">Read Blog</a>

            <form action="/blog/<%= element._id %>?_method=DELETE" method="post">
              <button class="btn btn-primary" type="submit">DELETE </button>
            </form>

            <form action="/blog/<%= element._id %>/Edit" method="get">
              <button class="btn btn-primary" type="submit">Edit </button>
            </form>
            </div>


          </div>
        </div>
        <% }) %>
    </div>


    <%- include("./partials/scripts") %>
</body>

</html>