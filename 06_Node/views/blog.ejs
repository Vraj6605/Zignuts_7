<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("./partials/head") %>
    <title>
      blogify:<%= blog.title %>
    </title>
    <style>
      h1 {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: bolder;
      }

      p {
        font-size: 26px;
        font-family: 'Times New Roman', Times, serif;
      }
    </style>
</head>

<body>
  <%- include("./partials/nav") %>


    <div class="container mt-4" style="display: flex-1;">
      <div style="display: flex; justify-content: center;">
        <img style="width: 60%; height: 50%; margin: auto; border-radius: 30px;" src=<%=blog.coverImageURL %> alt="No
        Image">
      </div>

      <div class="mt-4">
        <div>
          <h1 class="fs-sm-1">
            Title : <%= blog.title %>
          </h1>

        </div>
        <div>
          <p style="text-align: justify;">
            <%= blog.body %>
          </p>
        </div>
      </div>
    </div>


    <%- include("./partials/scripts") %>
</body>

</html>