<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <style>
    form {
      width: 50%;
      margin: auto;
      text-align: center;
    }

    input,
    button {
      margin: auto;
      font-size: 18px;
      display: block;
      border-radius: 10px;
      padding: 5px 10px;
      margin-top: 10px;
    }

    label {
      font-size: 20px;
      font-weight: bolder;
    }

    h1 {
      color: rgb(22, 64, 64);
      font-weight: bolder;
      font-family: 'Courier New', Courier, monospace;
    }
  </style>
</head>
<body>
  <form action="/admin/login" method="post">
    <h1>Login Page</h1>
    <label >Email</label>
    <input type="email" name="email"  placeholder="Enter Your Email Here">
    <br>
    <label >Password</label>
    <input type="password" name="password"  placeholder="Enter Your Password Here">
    <br>
    <button type="submit">Login</button>
  </form>
</body>
</html>